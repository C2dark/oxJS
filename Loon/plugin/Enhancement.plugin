[Argument]
arg1 = switch,true,tag=SoraRemoveWatermark
arg2 = switch,true,tag=京东比价
arg3 = switch,true,tag=Spotify_lyrics_translation
arg4 = switch,true,tag=QQ_Redirect
arg5 = switch,true,tag=微信外部链接解锁
arg6 = switch,true,tag=移动查询接口
arg7 = switch,true,tag=建行生活净化
arg8 = switch,true,tag=酷安链接重定向




[Script]
#1 SoraRemoveWatermark
http-request ^https?:\/\/videos\.openai\.com\/.*vg-assets\/assets.*mp4 script-path=https://raw.githubusercontent.com/C2dark/oxJS/refs/heads/dev/Loon/Scripts/enhancement/SoraRemoveWatermark.js, timeout=60, enable ={arg1},tag=SoraRemoveWatermark

#2 京东比价
http-response ^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html script-path=https://raw.githubusercontent.com/C2dark/oxJS/refs/heads/dev/Loon/Scripts/enhancement/jd_price-wf021325.js, requires-body=true, timeout=60, enable ={arg2},tag=京东比价
http-request ^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu$ script-path=https://raw.githubusercontent.com/C2dark/oxJS/refs/heads/dev/Loon/Scripts/enhancement/jd_price-wf021325.js, requires-body=true, timeout=60, enable ={arg2},tag=京东比价

#3 Spotify_lyrics_translation
http-response ^https?:\/\/api\.spotify\.com\/v1\/tracks\? requires-body=true,script-path=https://raw.githubusercontent.com/C2dark/oxJS/refs/heads/dev/Loon/Scripts/enhancement/Spotify_response.js, enable ={arg3},tag=跟踪响应·JSON

http-request ^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json requires-body=true,script-path=https://raw.githubusercontent.com/C2dark/oxJS/refs/heads/dev/Loon/Scripts/enhancement/Spotify_request.js, enable ={arg3},tag=歌词请求·JSON
http-request ^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/\w+\?(.*) requires-body=true, binary-body-mode=true,script-path=https://raw.githubusercontent.com/C2dark/oxJS/refs/heads/dev/Loon/Scripts/enhancement/Spotify_request.js, enable ={arg3},tag=歌词请求·Proto

http-response ^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json(.*)subtype=Translate requires-body=true,script-path=https://raw.githubusercontent.com/C2dark/oxJS/refs/heads/dev/Loon/Scripts/enhancement/Translate_response.js, enable ={arg3},tag=翻译歌词响应·JSON
http-response ^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/\w+\?(.*)subtype=Translate requires-body=true, binary-body-mode=true,script-path=https://raw.githubusercontent.com/C2dark/oxJS/refs/heads/dev/Loon/Scripts/enhancement/Translate_response.js, enable ={arg3},tag=翻译歌词响应·Proto

http-response ^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json(.*)subtype=External requires-body=true,script-path=https://raw.githubusercontent.com/C2dark/oxJS/refs/heads/dev/Loon/Scripts/enhancement/External_Lyrics_response.js, enable ={arg3},tag=外部歌词响应·JSON
http-response ^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/\w+\?(.*)subtype=External requires-body=true, binary-body-mode=true,script-path=https://raw.githubusercontent.com/C2dark/oxJS/refs/heads/dev/Loon/Scripts/enhancement/External_Lyrics_response.js, enable ={arg3},tag=外部歌词响应·Proto

#4 

#5 UnblockURLinWeChat
http-response ^https\:\/\/(weixin110\.qq|security.wechat)\.com\/cgi-bin\/mmspamsupport-bin\/newredirectconfirmcgi\? script-path=https://kelee.one/Resource/JavaScript/Weixin/Weixin_external_links_unlock.js, requires-body=true, enable ={arg5},tag=微信外部链接解锁

#6 移动余量查询接口
http-request ^https?:\/\/api\.example\.com\/10086\/query script-path=https://raw.githubusercontent.com/C2dark/oxJS/refs/heads/dev/Loon/Scripts/enhancement/10086.js, requires-body=true, timeout=60, enable = {arg6},tag=移动查询接口

#7 建行生活净化
http-response ^https?:\/\/yunbusiness\.ccb\.com\/(basic_service|clp_service)\/txCtrl\?txcode=A3341AB0(3|5|8) script-path=https://raw.githubusercontent.com/C2dark/oxJS/refs/heads/dev/Loon/Scripts/adBlock/jhsh.js, requires-body=true, timeout=20, enable = {arg7}, tag=建行生活净化

#8酷安链接重定向
http-request ^https:\/\/www\.coolapk\.com\/link.* script-path=https://raw.githubusercontent.com/C2dark/oxJS/refs/heads/dev/Loon/Scripts/enhancement/Coolapk_Redirect.js, requires-body=false, timeout=10, enable = {arg8}, tag=酷安链接重定向





