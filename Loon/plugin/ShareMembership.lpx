#!name=共享会员
#!desc=在插件配置页面填写会员数据，首次使用时需启用此插件，最高仅支持7.20.2版。
#!openUrl=https://apps.apple.com/cn/app/id1067198688
#!author=佚名
#!tag=共享会员
#!system=
#!system_version=
#!loon_version=3.2.1(749)
#!homepage=https://gitlab.com/isous/loonresource/-/blob/main/README.md
#!icon=https://gitlab.com/isous/loonresource/-/raw/main/Icon/ColorfulCloudsPro.png
#!date=2024-09-28 22:05:37

[Argument]

arg1 = input,tag=令牌,desc=此处填写会员令牌

arg2 = input=Bilibili_Authorization
arg3 = input=Bilibili_User-Agent

#!input=cx_uid
#!input=cx_code
#!input=cx_device

#!input=163_Cookie
#!input=163_User-Agent
#!input=163_MConfig-Info

[Script]
#彩云天气共享会员
http-request ^https:\/\/wrapper\.cyapi\.cn\/v1\/(nafp\/origin_images|satellite)\? script-path=https://gitlab.com/isous/loonresource/-/raw/main/Script/ColorfulClouds/ColorfulClouds_shared_membership.js, enable= {arg1}, tag=彩云天气共享会员
http-response ^https:\/\/biz\.cyapi\.cn\/(api\/v1\/user_detail|p\/v1\/vip_info|v2\/user) script-path=https://gitlab.com/isous/loonresource/-/raw/main/Script/ColorfulClouds/ColorfulClouds_shared_membership.js,requires-body=true, enable= {arg1}, tag=彩云天气共享会员

#Bilibili共享会员
http-request ^https?:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.playerunite\.v1\.Player\/PlayViewUnite(\?.+)?$ script-path=https://gitlab.com/isous/loonresource/-/raw/main/Script/Bilibili/Bilibili_shared_membership.js, enable= {arg2}, tag=iPhone端共享会员
# http-request ^https?:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.player(unite\.v1\.Player\/PlayViewUnite|online\.v1\.PlayerOnline\/PlayerOnline) script-path=https://gitlab.com/isous/loonresource/-/raw/main/Script/Bilibili/Bilibili_shared_membership.js,tag=iPhone端共享会员
http-request ^https?:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.pgc\.gateway\.player\.v2\.PlayURL\/PlayView$ script-path=https://gitlab.com/isous/loonresource/-/raw/main/Script/Bilibili/Bilibili_shared_membership.js, enable= {arg3}, tag=iPad端共享会员

#财新共享会员
http-request ^https:\/\/gateway\.caixin\.com\/api\/app-api\/auth\/(groupImageValidate|neWValidate|validate|validateAudioAuth) script-path=https://gitlab.com/isous/loonresource/-/raw/main/Script/CaixinMedia/CaixinMedia_shared_membership.js,tag=共享会员

#网易云音乐共享会员
# 播放器会员歌曲
http-request ^https?:\/\/interface\d?\.music\.163\.com\/eapi\/(?:v1\/artist\/top\/song|v3\/discovery\/recommend\/songs) script-path=https://gitlab.com/isous/loonresource/-/raw/main/Script/NeteaseCloudMusic/NeteaseCloudMusic_shared_membership.js,tag=播放器会员歌曲
http-request ^https?:\/\/interface\d?\.music\.163\.com\/eapi\/v3\/song\/detail script-path=https://gitlab.com/isous/loonresource/-/raw/main/Script/NeteaseCloudMusic/NeteaseCloudMusic_shared_membership.js,tag=播放器会员歌曲
http-request ^https?:\/\/interface\d?\.music\.163\.com\/eapi\/song\/(?:chorus|enhance\/|play\/|type\/detail\/get) script-path=https://gitlab.com/isous/loonresource/-/raw/main/Script/NeteaseCloudMusic/NeteaseCloudMusic_shared_membership.js,tag=播放器会员歌曲

# 播放器会员皮肤
http-request ^https?:\/\/interface\d?\.music\.163\.com\/eapi\/playermode\/ script-path=https://gitlab.com/isous/loonresource/-/raw/main/Script/NeteaseCloudMusic/NeteaseCloudMusic_shared_membership.js,tag=播放器会员皮肤

# 搜索结果会员歌曲
http-request ^https?:\/\/interface\d?\.music\.163\.com\/eapi\/search\/(?:complex\/page|complex\/rec\/song\/get|song\/list\/page) script-path=https://gitlab.com/isous/loonresource/-/raw/main/Script/NeteaseCloudMusic/NeteaseCloudMusic_shared_membership.js,tag=搜索结果会员歌曲

# 侧边栏会员等级
http-request ^https?:\/\/interface\d?\.music\.163\.com\/eapi\/vipnewcenter\/app\/resource\/newaccountpage script-path=https://gitlab.com/isous/loonresource/-/raw/main/Script/NeteaseCloudMusic/NeteaseCloudMusic_shared_membership.js,tag=侧边栏会员等级

# 歌单列表会员认证
http-request ^https?:\/\/interface\d?\.music\.163\.com\/w?e?api\/(homepage\/|v6\/)?playlist\/(?!(?:delete|subscribe|unsubscribe)) script-path=https://gitlab.com/isous/loonresource/-/raw/main/Script/NeteaseCloudMusic/NeteaseCloudMusic_shared_membership.js,tag=歌单列表会员认证

# 会员认证
http-request ^https?:\/\/interface\d?\.music\.163\.com\/eapi\/vipauth\/app\/auth\/(soundquality\/)?query script-path=https://gitlab.com/isous/loonresource/-/raw/main/Script/NeteaseCloudMusic/NeteaseCloudMusic_shared_membership.js,tag=会员认证

[MitM]
hostname=wrapper.cyapi.cn,biz.cyapi.cn, grpc.biliapi.net,app.bilibili.com, gateway.caixin.com, interface*.music.163.com, 